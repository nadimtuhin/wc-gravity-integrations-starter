{
  "name": "nadimtuhin/wc-gravity-integrations-starter",
  "description": "Custom WooCommerce and Gravity Forms integration architecture following WordPress Best Practices",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Nadim Tuhin",
      "email": "nadimtuhin@gmail.com",
      "homepage": "https://nadimtuhin.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "WCGravityIntegrations\\": "includes/"
    },
    "classmap": [
      "includes/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "WCGravityIntegrations\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "lint": "phpcs",
    "lint:fix": "phpcbf"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.33"
    }
  }
}
